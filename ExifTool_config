# Custom ExifTool configuration to expose some vendor-specific settings for a Ricoh GR III camera. Tested using ExifTool v13.55 and RICOH GR III v2.10.

# Shortcut to show the fields the same way they are on the camera, in the same order.
%Image::ExifTool::UserDefined::Shortcuts = (
    GR3 => [
        'GR3CropMode',
        'WhiteBalance',
        'GR3WBShiftName',
        'PeripheralIlluminationCorr',
        'GR3HighlightCorrection',
        'ShadowCorrection',
        'SensitivityAdjust',
        'ImageTone',
        'GR3Saturation',
        'GR3Hue',
        'GR3HighLowKey',
        'GR3Contrast',
        'GR3ContrastHighlight',
        'GR3ContrastShadow',
        'GR3Sharpness',
        'GR3Shading',
        'GR3Clarity',
        'GR3BWToning',
        'GR3BWFilterEffect',
        'GR3BWGrainEffect',
        'GR3BleachBypassToning',
        'GR3RetroToning',
        'GR3HDRToneToning',
        'GR3HDRToneHDRToneLevel',
        'GR3CrossProcessingColorTone',
        'GR3Recipe',
    ],

    # Extra shortcut to show the debugging data.
    GR3Debug => [
        'GR3CropMode#', # The "#" shows underlying value instead of the PrintConv one.
        'GR3ImageControlData' # I _want_ the PrintConv version for this one though.
    ],
);

%Image::ExifTool::UserDefined = (
    # Extract vendor-specific fields for the Ricoh GR III
    'Image::ExifTool::Pentax::Main' => {
        # This is where it stores the crop mode, 35mm/50mm, etc.
        # L=0 0 0, M=0 5 0, S=0 6 0
        0x0098 => {
            Name     => 'GR3CropMode',
            Writable => 'int8u',
            Count    => 3,

            # Describe it the same way the camera does.
            PrintConv => q{
                return 'L (28mm)' if $val eq '0 0 0';
                return 'M (35mm)' if $val eq '0 5 0';
                return 'S (50mm)' if $val eq '0 6 0';
                return "Unknown ($val)";
            },

            # Allow setting it by just providing S/M/L.
            PrintConvInv => q{
                return '0 0 0' if $val eq 'L';
                return '0 5 0' if $val eq 'M';
                return '0 6 0' if $val eq 'S';
                return $val;
            },
        },
        # This 44-byte blob is where the Image Control customizations
        # seem to be stored. I use composite fields later to get each
        # individual property from this blob.
        0x0247 => {
            Name     => 'GR3ImageControlData',
            Writable => 'undef',
            Count    => 44,

            # Show this in hex so I can more easily compare to find other offsets.
            PrintConv => q{
                return unpack('H*', $val);
            },
        },
    },

    # Create a bunch of new fields based on the available data.
    'Image::ExifTool::Composite' => {
        # This is identical to GR3CropMode, but it needs to be a composite
        # for digiKam to see it. So er.. I'm making it one.
        GR3CropModeName => {
            Require   => 'GR3CropMode',
            ValueConv => '$self->GetValue("GR3CropMode")',
        },

        # Show WB adjustments like they are on the camera. The values are already
        # available in "WBShiftAB" and "WBShiftGM". I just want to show them as
        # strings like "A3", "G2A2", "M7B9", etc. just like the camera does.
        GR3WBShiftName => {
            # We don't need both, so "Desire" instead of "Require".
            Desire => {
                0 => 'WBShiftGM',
                1 => 'WBShiftAB',
            },
            # Underlying values are already in other fields, so not bothering with
            # PrintConv for this one, just straight up creating the new value.
            ValueConv => q{
                my $gm = $self->GetValue('WBShiftGM');
                my $ab = $self->GetValue('WBShiftAB');

                my $result = '';
                # For GM, G is +ve, for AB, B is +ve ಠ_ಠ
                $result .= 'G' . $gm      if $gm > 0;
                $result .= 'M' . abs($gm) if $gm < 0;
                $result .= 'A' . abs($ab) if $ab < 0;
                $result .= 'B' . $ab      if $ab > 0;

                return $result || undef;
            },
        },

        # Highlight correction is encoded as part of DynamicRangeExpansion.
        # This pulls it out as a new field to match the value shown on the camera.
        GR3HighlightCorrection => {
            Require   => 'DynamicRangeExpansion',
            ValueConv => '((split(" ", $val))[1])',
            PrintConv => q{
                return 'On'   if $val == 1;
                return 'Auto' if $val == 2;
                return 'Off'  if $val == 0;
                return "Unknown ($val)";
            },
        },

        # Image Control Settings
        GR3Saturation => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") ne ""',
            ValueConv => 'unpack("s<", substr($val, 0, 2))',
            PrintConv => q{
                return 'N/A' if $val == -32768;
                return $val;
            },
        },
        GR3Hue => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") ne ""',
            ValueConv => 'unpack("s<", substr($val, 2, 2))',
            PrintConv => q{
                return 'N/A' if $val == -32768;
                return $val;
            },
        },
        # None of the rest are available for "HDR Tone".
        GR3HighLowKey => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") ne "HDR Tone"',
            ValueConv => 'unpack("s<", substr($val, 4, 2))',
            PrintConv => q{
                return 'N/A' if $val == -32768;
                return $val;
            },
        },
        GR3Contrast => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") ne "HDR Tone"',
            ValueConv => 'unpack("s<", substr($val, 6, 2))',
            PrintConv => q{
                return 'N/A' if $val == -32768;
                return $val;
            },
        },
        GR3ContrastHighlight => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") ne "HDR Tone"',
            ValueConv => 'unpack("s<", substr($val, 8, 2))',
            PrintConv => q{
                return 'N/A' if $val == -32768;
                return $val;
            },
        },
        GR3ContrastShadow => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") ne "HDR Tone"',
            ValueConv => 'unpack("s<", substr($val, 10, 2))',
            PrintConv => q{
                return 'N/A' if $val == -32768;
                return $val;
            },
        },
        GR3Sharpness => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") ne "HDR Tone"',
            ValueConv => 'unpack("s<", substr($val, 12, 2))',
            PrintConv => q{
                return 'N/A' if $val == -32768;
                return $val;
            },
        },
        GR3Shading => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") ne "HDR Tone"',
            ValueConv => 'unpack("s<", substr($val, 18, 2))',
            PrintConv => q{
                return 'N/A' if $val == -32768;
                return $val;
            },
        },
        GR3Clarity => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") ne "HDR Tone"',
            ValueConv => 'unpack("s<", substr($val, 20, 2))',
            PrintConv => q{
                return 'N/A' if $val == -32768;
                return $val;
            },
        },

        # These ones are only used for BW/Monotone modes.
        GR3BWToning => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") =~ /Monotone|B&W/',
            ValueConv => 'unpack("s<", substr($val, 26, 2))',
            PrintConv => q{
                return 'N/A'    if $val == -1;
                return 'Off'    if $val == 0;
                return 'Sepia'  if $val == 1;
                return 'Red'    if $val == 2;
                return 'Green'  if $val == 3;
                return 'Blue'   if $val == 4;
                return 'Purple' if $val == 5;
                return "Unknown ($val)";
            },
        },
        # Note: This isn't available in "Hard BW" mode.
        GR3BWFilterEffect => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") =~ /Monotone|B&W/ && ($self->GetValue("ImageTone") // "") !~ /^Hard/',
            # I think just the raw 4 numbers makes most sense for the value representation of this.
            ValueConv => q{
                my $flags = unpack('C', substr($val, 34, 1));
                my $r = unpack('C', substr($val, 35, 1));
                my $g = unpack('C', substr($val, 36, 1));
                my $b = unpack('C', substr($val, 37, 1));

                $r = -$r if $flags & 0x10;
                $g = -$g if $flags & 0x20;
                $b = -$b if $flags & 0x40;

                return sprintf('%d,%d,%d,%d', $flags, $r, $g, $b);
            },
            # For the pretty output, make it match how the camera shows it.
            # Oh, and include the preset number if it matches one of those, that's helpful too.
            PrintConv => q{
                my ($flags, $r, $g, $b) = split(',', $val);

                return 'Off' if $flags == 0x00;
                return 'N/A' if $flags & 0x08;

                my $result = sprintf('On; R%+d%%, G%+d%%, B%+d%%', $r, $g, $b);

                $result .= ' (Preset 1)' if $r == 10  && $g == 70 && $b == 20;
                $result .= ' (Preset 2)' if $r == 40  && $g == 50 && $b == 10;
                $result .= ' (Preset 3)' if $r == 90  && $g == 20 && $b == -10;
                $result .= ' (Preset 4)' if $r == 120 && $g == -10 && $b == -10;

                return $result;
            },
        },
        GR3BWGrainEffect => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") =~ /Monotone|B&W/',
            ValueConv => 'unpack("s<", substr($val, 38, 2))',
            PrintConv => q{
                return 'N/A' if $val == 8;
                return 'Off' if $val == 0;
                return '3'   if $val == 1; # Strong
                return '2'   if $val == 3; # Medium
                return '1'   if $val == 5; # Weak
                return "Unknown ($val)";
            },
        },

        # This is only used in "Bleach Bypass" mode.
        GR3BleachBypassToning => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") =~ /Bleach Bypass/',
            ValueConv => 'unpack("s<", substr($val, 28, 2))',
            PrintConv => q{
                return 'N/A'      if $val == -1;
                return 'Off'      if $val == 0;
                return 'C (Cold)' if $val == 1;
                return 'W (Warm)' if $val == 2;
                return "Unknown ($val)";
            },
        },

        # This is only used in "Retro" mode.
        GR3RetroToning => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") eq "Retro"',
            ValueConv => 'unpack("s<", substr($val, 16, 2))',
            PrintConv => q{
                return 'N/A' if $val == -32768;
                return $val;
            },
        },

        # And these ones are only in "HDR Tone" mode.
        GR3HDRToneToning => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") eq "HDR Tone"',
            ValueConv => 'unpack("s<", substr($val, 30, 2))',
            PrintConv => q{
                return 'Off' if $val == 0;
                return 'BW'  if $val == 1;
                return 'S'   if $val == 2;
                return "Unknown ($val)";
            },
        },
        GR3HDRToneHDRToneLevel => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") eq "HDR Tone"',
            ValueConv => 'unpack("s<", substr($val, 32, 2))',
            PrintConv => q{
                return 'Low'    if $val == 1;
                return 'Med'    if $val == 2;
                return 'High'   if $val == 3;
                return "Unknown ($val)";
            },
        },

        # This one is only used in "Cross Processing" mode.
        GR3CrossProcessingColorTone => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("ImageTone") // "") =~ /Cross Processing/',
            ValueConv => 'unpack("s<", substr($val, 42, 2))',
            PrintConv => q{
                return 'N/A'     if $val == -1;
                return 'Blue'    if $val == 1;
                return 'Magenta' if $val == 2;
                return 'Yellow'  if $val == 3;
                return "Unknown ($val)";
            },
        },

        #######################################################################
        # Recipes

        GR3Recipe => {
            Require   => 'GR3ImageControlData',
            Condition => '($self->GetValue("Model") // "") eq "RICOH GR III"',
            ValueConv => q{
                # Using the image control data bytes directly rather than the
                # above composites, since it's way less verbose this way.
                my $settings = join(',', map {
                    unpack('s<', substr($val, $_, 2))
                } (0, 2, 4, 6, 8, 10, 12, 18, 20));

                ###############################################################

                # https://reggiebphotography.com/blog/The-Most-Versatile-Ricoh-GR-III-GR-IIIx-Film-Simulation-Recipe-Reggies-Color-Negative
                return 'Reggie\'s Color Negative'
                    if $self->GetValue('ImageTone') eq 'Negative Film'
                    && $settings eq '2,0,0,3,-4,-1,1,0,0'
                    && $self->GetValue('GR3HighlightCorrection') eq 'Auto'
                    && $self->GetValue('ShadowCorrection') eq 'Normal'
                    && $self->GetValue('HighISONoiseReduction') eq 'Off; Inactive'
                    && $self->GetValue('WhiteBalance') =~ /Auto/
                    && $self->GetValue('GR3WBShiftName') eq 'A6'
                    ;

                # Add any more that you want...

                # Don't show the field if no recipe was identified.
                return undef;
            },
        },
    },
);

1;
